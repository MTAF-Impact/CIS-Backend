# ==========================================================================
# CIS Backend — environment template
#
# Copy to .env and fill in real values. NEVER commit .env — it is gitignored.
# No credential in this file is real; every value below is a placeholder.
# ==========================================================================

# --------------------------------------------------------------------------
# Application
# --------------------------------------------------------------------------
APP_NAME="CIS Backend"
APP_ENV=development                       # development | staging | production
APP_PORT=8080

# Comma-separated browser origins allowed to call the API.
# Use explicit origins in production; "*" disables credentialed CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Max request body in bytes. 0 = effectively unlimited (~2 GiB), which is what
# PRD US40's "no file-size limit" policy upload requires.
APP_BODY_LIMIT_BYTES=0

# Generous timeouts so a large policy document upload is not cut off.
APP_READ_TIMEOUT=5m
APP_WRITE_TIMEOUT=5m

# --------------------------------------------------------------------------
# Database — Supabase Postgres
#
# Get these from: Supabase dashboard > Project Settings > Database.
#
# IMPORTANT: this database is shared with the AI service. This backend only
# ever creates and writes tables prefixed `cis_`; the AI service's tables are
# read-only to it. See docs/DATABASE.md.
# --------------------------------------------------------------------------

# Option A (recommended) — full connection string.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Option B — discrete fields, used only when DATABASE_URL is empty.
# DB_HOST=aws-0-REGION.pooler.supabase.com
# DB_PORT=5432
# DB_USER=postgres.YOUR_PROJECT_REF
# DB_PASSWORD=YOUR_PASSWORD
# DB_NAME=postgres
# DB_SSLMODE=require

# Set to true ONLY when connecting through the transaction-mode pooler
# (port 6543), which cannot handle pgx's prepared statements.
DB_PREFER_SIMPLE_PROTOCOL=false

DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_LOG_LEVEL=warn                         # silent | error | warn | info

# Creates/updates the cis_* tables on boot. Never touches AI-owned tables.
DB_AUTO_MIGRATE=true

# --------------------------------------------------------------------------
# Authentication
#
# Generate a secret with:  openssl rand -base64 48
# Must be at least 32 characters when APP_ENV=production.
# --------------------------------------------------------------------------
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=720h
JWT_ISSUER=cis-backend
BCRYPT_COST=12

# Allow anyone to POST /api/v1/auth/register. Set false once your team has
# accounts, and create users via the seed variables below instead.
AUTH_ALLOW_REGISTRATION=true

# Optional: creates this account on boot when it does not already exist.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_NAME=CIS Admin

# --------------------------------------------------------------------------
# File storage — policy documents (PRD US40/US37)
# --------------------------------------------------------------------------
STORAGE_DRIVER=supabase                   # supabase | local

# Supabase driver. Find these under Project Settings > API.
# The service-role key bypasses row-level security: keep it server-side only.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=policy-documents
SUPABASE_SIGNED_URL_TTL=1h

# Local driver (development only). Files are lost unless this is a volume.
STORAGE_LOCAL_DIR=./uploads

# --------------------------------------------------------------------------
# AI service integration
#
# Leave AI_SERVICE_URL empty to run without the AI service. Policy uploads then
# record processing_status="skipped" instead of hanging on a Processing badge,
# and the F4 "Generate Generic Claim" button returns 503.
# See docs/AI-INTEGRATION.md.
# --------------------------------------------------------------------------
AI_SERVICE_URL=
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT=30s
AI_SERVICE_MATCHMAKING_PATH=/api/v1/matchmaking/policies
AI_SERVICE_GENERATE_CLAIM_PATH=/api/v1/claims/generate-generic

# Optional shared secret the AI service presents in X-Internal-Key when
# calling back. Leave empty to accept callback requests with no auth header
# (only safe when the backend and AI service are reachable exclusively over a
# private network); set on both sides to require and validate the header.
INTERNAL_API_KEY=

# --------------------------------------------------------------------------
# Background jobs (cron syntax, UTC)
# --------------------------------------------------------------------------
CRON_ENABLED=true
# US41: flip policies to Rolled Out once their date arrives. Daily at 01:00.
CRON_POLICY_ROLLOUT_SPEC=0 1 * * *
# Capture watched claims' scores to build the F3 chart history. Hourly.
CRON_SCORE_SNAPSHOT_SPEC=0 * * * *
